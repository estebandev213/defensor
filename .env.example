NODE_ENV=development
APP_URL=http://localhost:3000
APP_VERSION=0.1.0

DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supported: groq, openai, openai-compatible
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Supported: jina, openai
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Must match the database vector dimension in the legal_chunks migration.
EMBEDDING_DIMENSIONS=1024

RERANKER_PROVIDER=
RERANKER_API_KEY=
RERANKER_MODEL=

TELEMETRY_PROVIDER=
TELEMETRY_API_KEY=
TELEMETRY_ENABLED=false

RATE_LIMIT_PROVIDER=
RATE_LIMIT_SECRET=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_DAILY_MAX=100
REQUEST_TIMEOUT_MS=12000
PII_REDACTION_ENABLED=true

LEGAL_CORPUS_VERSION=peru-labor-v1-2026-07-26
LOG_LEVEL=info
