{
  "name": "defensor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/db/migrate.ts",
    "db:check": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/db/check.ts",
    "ingest": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/ingest/index.ts",
    "ingest:dry": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/ingest/index.ts --dry-run",
    "ingest:validate": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/ingest/validate.ts",
    "ingest:pdf": "python scripts/ingest/build-corpus.py",
    "retrieval:debug": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/retrieval/debug.ts",
    "eval": "tsx scripts/evaluate/run.ts",
    "eval:retrieval": "tsx scripts/evaluate/retrieval.ts",
    "eval:answers": "tsx scripts/evaluate/answers.ts",
    "eval:report": "tsx scripts/evaluate/report.ts",
    "corpus:export": "tsx scripts/maintenance/export-corpus.ts",
    "security:scan": "tsx scripts/security/scan-secrets.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "next": "15.5.9",
    "next-themes": "0.4.4",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@tailwindcss/forms": "0.5.10",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.30",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "autoprefixer": "10.4.21",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.9",
    "jsdom": "26.1.0",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.1",
    "typescript": "5.8.3",
    "vitest": "3.1.3"
  }
}
